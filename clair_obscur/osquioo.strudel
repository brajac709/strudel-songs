setcpm(150/4) // lumiere


const TRANSITION = sound("bd*16");

const RHYTHM1 = stack(
    sound("shaker_small*16").gain(5),
    sound("bd").beat("0,3,4,6,10,12", 16),
    sound("rim").beat("0,6,12",16).gain(.4)
)

const BASS1 = sound("f#3")
    .sound("saw")
    .legato(1.5)
    .fm(3)
    //.fmattack(.2)
    .fmdecay(.5)
    .fmsustain(.8)
    .beat("0,6,12",16)
    .scope()

// this isn't really osquio, but it is fun
const HIGH = sound("<f#7 a#8 c#8 d8>")
    .sound("supersaw")
    .beat("0,1,2,3,4,5,7,9,12", 16)
    .scope()

$: stack(
    RHYTHM1,
    BASS1,
    HIGH
)